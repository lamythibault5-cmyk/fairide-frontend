{
  "name": "fairide-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:greffons": "node scripts/verifier-greffons-android.mjs",
    "app:sync": "npm run build && npx cap sync",
    "app:android": "npm run app:sync && npx cap open android",
    "app:ios": "npm run app:sync && npx cap open ios",
    "app:ios:production": "VITE_API_BASE=https://fairide-backend-production.up.railway.app/api VITE_STOCK_DISH_PHOTOS=off npm run app:sync && npx cap open ios",
    "icones:site": "node scripts/icones-site.mjs",
    "app:assets": "node scripts/app-assets.mjs && npx @capacitor/assets generate --android --iconBackgroundColor \"#3B2FB5\" --iconBackgroundColorDark \"#3B2FB5\" --splashBackgroundColor \"#3B2FB5\" --splashBackgroundColorDark \"#3B2FB5\" && node scripts/app-assets.mjs --icones-android",
    "app:assets:ios": "npx @capacitor/assets generate --ios --iconBackgroundColor \"#3B2FB5\" --splashBackgroundColor \"#3B2FB5\" --splashBackgroundColorDark \"#3B2FB5\"",
    "check:app": "node scripts/verifier-appli.mjs",
    "check:barres": "node scripts/verifier-barres-bas.mjs",
    "postinstall": "node scripts/corriger-connexion-google.mjs"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@capgo/capacitor-social-login": "^7.20.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.70.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright-core": "^1.48.2",
    "vite": "^8.3.5"
  }
}
